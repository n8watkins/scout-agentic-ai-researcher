# --- Scout · Agentic Research Assistant ---

# Server demo-key fallback (optional; BYOK preferred). Visitors can run on this
# shared key while it has capacity. Bring-your-own-key is unlimited.
GEMINI_API_KEY=

# Which Gemini model to use for plan / decide / synthesize.
# Default: gemini-3.1-flash-lite. Bump to a stronger Flash if the loop misbehaves.
SCOUT_MODEL=gemini-3.1-flash-lite

# Web search (server-side only). Tavily is primary; Google CSE is the fallback
# and reuses gemini-chat-app's variable names.
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3100
PORT=3100

# --- Demo limits & abuse guards (all optional; code defaults shown) ---
# See src/lib/usage.ts. These cap the SHARED demo key only; bring-your-own-key
# visitors are exempt.
#
# Real ceiling: demo Gemini model calls per rolling 24h window. One run is ~15
# calls, so this is counted in calls, not runs. (This app's half of a shared
# 500/day key.)
SCOUT_DEMO_CALL_BUDGET=250
# Light per-IP guard: research runs started per IP, per 1h window.
SCOUT_PER_IP_RUN_LIMIT=8
# Run-history write guard: POST/DELETE /api/runs per session (or IP), per minute.
SCOUT_RUN_WRITE_LIMIT=60
