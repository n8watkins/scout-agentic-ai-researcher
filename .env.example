# --- Scout · Agentic Research Assistant ---

# Server demo-key fallback (optional; BYOK preferred). Visitors can run on this
# shared key while it has capacity. Bring-your-own-key is unlimited.
GEMINI_API_KEY=

# Which Gemini model to use for plan / decide / synthesize.
# Default: gemini-3.1-flash-lite. Bump to a stronger Flash if the loop misbehaves.
SCOUT_MODEL=gemini-3.1-flash-lite

# Web search (server-side only). Tavily is primary; Google CSE is the fallback
# and reuses gemini-chat-app's variable names.
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3100
PORT=3100
